            <textField isBlankWhenNull="true">
                <reportElement x="20" y="35" width="550" height="18" forecolor="#E0E8FF" uuid="d1e2f3a4-b5c6-7890-1234-56789abcdef2"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Audit Report | Filters: Species = " + $P{SPECIES_FILTER} + " | Status = " + $P{STATUS_FILTER}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="600" y="20" width="180" height="20" forecolor="#FFFFFF" uuid="d1e2f3a4-b5c6-7890-1234-56789abcdef3"/>
