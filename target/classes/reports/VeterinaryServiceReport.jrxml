<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="VeterinaryServiceReport" 
              pageWidth="842" 
              pageHeight="595" 
              orientation="Landscape" 
              columnWidth="802" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20" 
              uuid="b67e7c96-1234-4567-89ab-cdef01234567">
    
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <!-- Report Parameters for Dynamic UI Filtering -->
    <parameter name="SPECIES_FILTER" class="java.lang.String">
        <defaultValueExpression><![CDATA["All Species"]]></defaultValueExpression>
    </parameter>
    <parameter name="STATUS_FILTER" class="java.lang.String">
        <defaultValueExpression><![CDATA["All Statuses"]]></defaultValueExpression>
    </parameter>

    <!-- Query joining 4 tables: appointments, customers, pets, treatments with filter support -->
    <queryString>
        <![CDATA[
        SELECT 
            a.appointment_code, 
            a.appointment_date, 
            c.full_name AS customer_name, 
            c.phone AS customer_phone, 
            p.name AS pet_name, 
            p.species, 
            p.breed, 
            a.vet_doctor, 
            t.diagnosis, 
            t.procedure_details, 
            t.medication_cost, 
            t.treatment_cost, 
            t.total_amount, 
            t.status AS payment_status
        FROM appointments a
        JOIN customers c ON a.customer_id = c.id
        JOIN pets p ON a.pet_id = p.id
        JOIN treatments t ON t.appointment_id = a.id
        WHERE ($P{SPECIES_FILTER} IS NULL OR $P{SPECIES_FILTER} = 'All Species' OR $P{SPECIES_FILTER} = 'All' OR p.species = $P{SPECIES_FILTER})
          AND ($P{STATUS_FILTER} IS NULL OR $P{STATUS_FILTER} = 'All Statuses' OR $P{STATUS_FILTER} = 'All' OR t.status = $P{STATUS_FILTER})
        ORDER BY a.appointment_date DESC;
        ]]>
    </queryString>

    <field name="appointment_code" class="java.lang.String"/>
    <field name="appointment_date" class="java.sql.Date"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="customer_phone" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="species" class="java.lang.String"/>
    <field name="breed" class="java.lang.String"/>
    <field name="vet_doctor" class="java.lang.String"/>
    <field name="diagnosis" class="java.lang.String"/>
    <field name="procedure_details" class="java.lang.String"/>
    <field name="medication_cost" class="java.math.BigDecimal"/>
    <field name="treatment_cost" class="java.math.BigDecimal"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="payment_status" class="java.lang.String"/>

    <variable name="TOTAL_REVENUE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>
